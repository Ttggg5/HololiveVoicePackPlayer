<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card: a translucent pane lighter at the top, a diagonal sheen and a bright rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/widget_glass_bottom"
                android:startColor="@color/widget_glass_top" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#00FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="@color/widget_glass_sheen" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_rim" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
