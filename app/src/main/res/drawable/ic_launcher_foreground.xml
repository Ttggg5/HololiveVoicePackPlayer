<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground: microphone on top, a white badge with the hololive logo below.
    The logo slot uses @drawable/hololive_logo (see README "App icon" to add the real logo).
    Everything stays inside the 66dp safe zone of the 108dp adaptive canvas.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_mic" />
    <item
        android:bottom="28dp"
        android:drawable="@drawable/ic_launcher_logo_badge"
        android:left="26dp"
        android:right="26dp"
        android:top="62dp" />
    <item
        android:bottom="30dp"
        android:drawable="@drawable/hololive_logo"
        android:left="30dp"
        android:right="30dp"
        android:top="64dp" />
</layer-list>
